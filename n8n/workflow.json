{
  "id": "HeidiLeadsWeekly",
  "name": "Heidi lead pipeline (weekly)",
  "nodes": [
    {
      "parameters": {},
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e01",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 1"
            }
          ]
        }
      },
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e02",
      "name": "Every Monday 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"stages\": [\"all\"],\n  \"mode\": \"incremental\",\n  \"callback_url\": \"{{ $execution.resumeUrl }}\"\n}",
        "options": {}
      },
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e03",
      "name": "Start run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 100]
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWait": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 6,
        "resumeUnit": "hours",
        "options": {}
      },
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e04",
      "name": "Wait for run",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [480, 100],
      "webhookId": "3c9d2f7e-8a41-4b6e-9f15-2d7c8e0a5b61"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1d4e7f0-1111-4c2b-8e3a-5f6b7c8d9e01",
              "leftValue": "={{ $json.body ? $json.body.status : 'no callback' }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e05",
      "name": "Run ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 100]
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:8000/runs/{{ $('Start run').item.json.run_id }}/changes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e06",
      "name": "Get changes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b2e5f8a1-2222-4d3c-9f4b-6a7c8d9e0f01",
              "name": "run_id",
              "value": "={{ $json.run_id }}",
              "type": "string"
            },
            {
              "id": "b2e5f8a1-2222-4d3c-9f4b-6a7c8d9e0f02",
              "name": "counts_per_stage",
              "value": "={{ Object.fromEntries($('Wait for run').item.json.body.stages.map(s => [s.stage, { status: s.status, counts: s.counts }])) }}",
              "type": "object"
            },
            {
              "id": "b2e5f8a1-2222-4d3c-9f4b-6a7c8d9e0f03",
              "name": "skipped_stages",
              "value": "={{ $('Wait for run').item.json.body.stages.filter(s => s.status === 'skipped').map(s => s.stage) }}",
              "type": "array"
            },
            {
              "id": "b2e5f8a1-2222-4d3c-9f4b-6a7c8d9e0f04",
              "name": "new_companies",
              "value": "={{ $json.new.map(c => c.company_name + (c.bezirk ? ' (' + c.bezirk + ')' : '') + ' [' + c.status + ']') }}",
              "type": "array"
            },
            {
              "id": "b2e5f8a1-2222-4d3c-9f4b-6a7c8d9e0f05",
              "name": "new_high_priority_leads",
              "value": "={{ $json.new_high_priority.map(c => c.company_name + ': ' + c.priority_why) }}",
              "type": "array"
            },
            {
              "id": "b2e5f8a1-2222-4d3c-9f4b-6a7c8d9e0f06",
              "name": "changed_companies",
              "value": "={{ $json.counts.changed }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e07",
      "name": "Digest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c3f6a9b2-3333-4e4d-8a5c-7b8d9e0f1a01",
              "name": "run_id",
              "value": "={{ $('Start run').item.json.run_id }}",
              "type": "string"
            },
            {
              "id": "c3f6a9b2-3333-4e4d-8a5c-7b8d9e0f1a02",
              "name": "status",
              "value": "={{ $json.body ? $json.body.status : 'no callback within 6 h' }}",
              "type": "string"
            },
            {
              "id": "c3f6a9b2-3333-4e4d-8a5c-7b8d9e0f1a03",
              "name": "failing_stage",
              "value": "={{ $json.body && $json.body.stages ? ($json.body.stages.filter(s => s.status === 'failed').map(s => s.stage)[0] || 'none') : 'unknown (no callback)' }}",
              "type": "string"
            },
            {
              "id": "c3f6a9b2-3333-4e4d-8a5c-7b8d9e0f1a04",
              "name": "errors",
              "value": "={{ $json.body && $json.body.stages ? $json.body.stages.filter(s => s.status === 'failed').map(s => s.errors).flat() : [] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "6f0c1a52-3b1e-4c1a-9d0e-0a1b2c3d4e08",
      "name": "Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, 220]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Start run", "type": "main", "index": 0 }]]
    },
    "Every Monday 06:00": {
      "main": [[{ "node": "Start run", "type": "main", "index": 0 }]]
    },
    "Start run": {
      "main": [[{ "node": "Wait for run", "type": "main", "index": 0 }]]
    },
    "Wait for run": {
      "main": [[{ "node": "Run ok?", "type": "main", "index": 0 }]]
    },
    "Run ok?": {
      "main": [
        [{ "node": "Get changes", "type": "main", "index": 0 }],
        [{ "node": "Error", "type": "main", "index": 0 }]
      ]
    },
    "Get changes": {
      "main": [[{ "node": "Digest", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Berlin"
  },
  "pinData": {}
}
